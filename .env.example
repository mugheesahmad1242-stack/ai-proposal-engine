# --- Supabase (required) ---
# Project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Public/anon key: Settings -> API -> "anon public" key (legacy) OR the new
# "sb_publishable_..." key. This is safe to expose to the browser and is the
# ONLY Supabase key that may use the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: Settings -> API -> "service_role" key (legacy) OR the new
# "sb_secret_..." key. SERVER-ONLY. Never prefix this with NEXT_PUBLIC_ and
# never expose it to the browser. Used only by app/api/share/[token] and
# app/api/proposals/[id]/share to read/create shares with elevated access
# for the public share-link feature. Optional: without it, share links are
# disabled and the app otherwise works normally with the anon key + RLS.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI generation (optional; falls back to deterministic, fact-only content) ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
# Max time to wait for a single Gemini generateContent call before giving up on that source.
GEMINI_TIMEOUT_MS=15000

# --- Source analysis (optional) ---
SOURCE_ANALYSIS_PROVIDER=firecrawl
FIRECRAWL_API_KEY=
# Max time to wait for a single website fetch before giving up on that source.
FIRECRAWL_TIMEOUT_MS=20000
# Hard cap on total processing time (fetch + AI) for a single source. Sources are
# analyzed concurrently, so this bounds worst-case analysis time regardless of how
# many sources a prospect has.
SOURCE_ANALYSIS_TIMEOUT_MS=50000

# --- Social API adapters (optional; server-only) ---
SOCIAL_API_TIMEOUT_MS=15000
META_ACCESS_TOKEN=
LINKEDIN_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
